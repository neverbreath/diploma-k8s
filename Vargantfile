Vagrant.configure("2") do |config|

  # ---------- Prod-Server ----------
  config.vm.define "prod-server" do |ps|
    ps.vm.box = "BaseALT/alt-server-10-amd64"
    ps.vm.hostname = "prod-server"
    ps.vm.network "private_network", ip: "192.168.100.10"
    ps.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end

    # Create admin user with sudo
    ps.vm.provision "shell", inline: <<-SHELL
      # Create user admin if it does not exist yet
      id -u admin &>/dev/null || useradd -m -s /bin/bash admin
      # Set password (optional)
      echo "admin:password" | chpasswd
      # Grant passwordless sudo privileges
      echo "admin ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/admin
      chmod 440 /etc/sudoers.d/admin
      # Optionally add to docker group (will be created later, but can be done now)
      # groupadd docker || true
      # usermod -aG docker admin
    SHELL

    # Main provisioning script runs as admin
    ps.vm.provision "shell", privileged: false, inline: <<-SHELL
      su - admin -c 'bash /vagrant/scripts/provision-master.sh'
    SHELL
  end

  # ---------- Dev-Workstation ----------
  config.vm.define "dev-workstation" do |dw|
    dw.vm.box = "BaseALT/alt-workstation-10-amd64"
    dw.vm.hostname = "dev-workstation"
    dw.vm.network "private_network", ip: "192.168.100.20"
    dw.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end

    # Create developer user with sudo
    dw.vm.provision "shell", inline: <<-SHELL
      id -u developer &>/dev/null || useradd -m -s /bin/bash developer
      echo "developer:password" | chpasswd
      echo "developer ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/developer
      chmod 440 /etc/sudoers.d/developer
      # The docker group will be created when docker is installed, but we can add now
      groupadd docker || true
      usermod -aG docker developer
    SHELL

    # Main provisioning script runs as developer
    dw.vm.provision "shell", privileged: false, inline: <<-SHELL
      su - developer -c 'bash /vagrant/scripts/provision-devel.sh'
    SHELL
  end

  # ---------- Client ----------
  config.vm.define "client" do |cl|
    cl.vm.box = "BaseALT/alt-workstation-10-amd64"
    cl.vm.hostname = "client"
    cl.vm.network "private_network", ip: "192.168.100.30"
    cl.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end
    # Attach client provisioning script
    cl.vm.provision "shell", path: "scripts/provision-client.sh", privileged: false
  end
end
